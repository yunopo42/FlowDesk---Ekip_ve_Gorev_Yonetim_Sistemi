# Flask oturumlarını imzalamak için uzun ve rastgele bir değer kullanın.
SECRET_KEY=buraya-guclu-ve-benzersiz-bir-anahtar-yazin

# Boş bırakılırsa proje kökündeki SQLite veritabanı kullanılır.
# Canlıda Supabase PostgreSQL bağlantısı buraya yazılacaktır.
DATABASE_URL=

# Geliştirme sunucusunun dinleyeceği adres ve port.
HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=false

# Yerelde false, HTTPS kullanan canlı ortamda true olmalıdır.
COOKIE_SECURE=false
APP_BASE_URL=http://127.0.0.1:5000
EMAIL_VERIFICATION_SALT=buraya-farkli-rastgele-bir-anahtar-yazin
PASSWORD_RESET_SALT=buraya-ucuncu-bir-rastgele-anahtar-yazin

# Geliştirme ortamı; canlıda Redis bağlantısı kullanılacaktır.
# Not: memory:// sayaçları süreç belleğinde tutar. Birden fazla worker ile
# çalışan canlı ortamda oran sınırlaması ancak Redis ile doğru çalışır.
RATELIMIT_STORAGE_URI=memory://

# Kaba kuvvet koruması. Giriş sayacı yalnızca BAŞARISIZ denemelerde artar,
# bu yüzden doğru parolayla giren kullanıcı kilitlenmez.
LOGIN_RATELIMIT=10 per 15 minutes
REGISTER_RATELIMIT=10 per hour
PASSWORD_RESET_RATELIMIT=5 per hour

# İçerik Güvenlik Politikası (XSS'e karşı katmanlı savunma).
# Satır içi betiğe izin verilmez; tüm JavaScript app/static/js altında durur.
# Yalnızca Tailwind ve Chart.js için jsdelivr CDN'ine izin verilir.
# Bu değeri değiştirirken tests/test_security_hardening.py testleri de
# gözden geçirilmelidir.
CONTENT_SECURITY_POLICY=default-src 'self'; script-src 'self' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' https://cdn.jsdelivr.net; form-action 'self'; frame-ancestors 'self'; base-uri 'self'; object-src 'none'

# Parola sıfırlama e-postaları. Yerelde true olduğunda e-posta gönderilmez;
# içerik geliştirme kutusuna ve terminal loguna yazılır.
MAIL_SUPPRESS_SEND=true
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=FlowDesk <noreply@example.com>
